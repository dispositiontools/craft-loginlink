{
    "name": "dispositiontools/craft-loginlink",
    "description": "Log in with a magic link",
    "type": "craft-plugin",
    "license": "proprietary",
    "version": "4.0.0",
    "support": {
        "email": "support@disposition.tools",
        "issues": "https://github.com/dispositiontools/craft-loginlink/issues?state=open",
        "source": "https://github.com/dispositiontools/craft-loginlink",
        "docs": "https://github.com/dispositiontools/craft-loginlink",
        "rss": "https://github.com/dispositiontools/craft-loginlink/releases.atom"
    },
    "require": {
        "php": ">=8.0.2",
        "craftcms/cms": "^4.5.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "dispositiontools\\loginlink\\": "src/"
        }
    },
    "extra": {
        "handle": "loginlink",
        "name": "Log in link",
        "developer": "Disposition Tools",
        "documentationUrl": "https://github.com/dispositiontools/craft-loginlink",
        "class": "dispositiontools\\loginlink\\Loginlink"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.0.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}

